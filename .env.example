# Copy to .env and fill in OPENAI_API_KEY before starting the stack.
#   cp .env.example .env

POSTGRES_USER=nexar
POSTGRES_PASSWORD=nexar
POSTGRES_DB=nexar_ops
DATABASE_URL=postgresql://nexar:nexar@db:5432/nexar_ops

LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

EMBEDDING_PROVIDER=local
ALLOW_LOCAL_TEST=true
CORS_ORIGINS=http://localhost:3001,http://localhost:3000,http://frontend:3000
INTERNAL_API_BASE_URL=http://backend:8000
