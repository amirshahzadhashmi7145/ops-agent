# Copy to .env and fill secrets before starting the stack.
#   cp .env.example .env

# --- Database ---
POSTGRES_USER=ops
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=ops_agent
DATABASE_URL=postgresql://ops:change-me-strong-password@db:5432/ops_agent

# development | production
APP_ENV=development

# --- Auth (recommended for production) ---
# REQUIRE_AUTH=true
# OPS_API_KEYS=replace-with-long-random-token
# Frontend can store the same token in localStorage key ops-agent.api-token
# and the actor email in ops-agent.user-email

# --- LLM ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Embeddings ---
EMBEDDING_PROVIDER=local

# Dev only: bypass SSRF private-range checks so tools can hit localhost.
# MUST be false in production (docker-compose.prod.yml forces this).
ALLOW_LOCAL_TEST=true

CORS_ORIGINS=http://localhost:3001,http://localhost:3000,http://frontend:3000
INTERNAL_API_BASE_URL=http://backend:8000

# Soft API rate limit per client IP (0 disables)
RATE_LIMIT_PER_MINUTE=120

# Cap chat history tokens sent to the model each turn
CHAT_HISTORY_MAX_MESSAGES=40

# Seed demo Workflows/Articles on startup (set false on scaled replicas after first boot)
SEED_PLAYBOOK_ON_STARTUP=true

# Hosting COGS for /usage pricing (monthly USD). Tune to your real VM bill.
# HOSTING_PROFILE=single_vm_docker
# HOSTING_PROVIDER_HINT=DigitalOcean NYC3
# HOSTING_COMPUTE_USD=48
# HOSTING_COMPUTE_SPECS=4 vCPU · 8 GB RAM
# HOSTING_DISK_USD=10
# HOSTING_DISK_SPECS=100 GB SSD
# HOSTING_BACKUP_USD=5
# HOSTING_EGRESS_USD=8
# HOSTING_EGRESS_SPECS=~1 TB egress
# HOSTING_OTHER_USD=0
# HOSTING_ASSUMED_CAPACITY_TICKETS=5000
